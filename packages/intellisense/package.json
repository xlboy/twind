{
  "name": "@phoenix-twind/intellisense",
  "version": "1.1.4-alpha.2",
  "description": "IntelliSense utilities for Twind (Phoenix)",
  "keywords": [
    "twind",
    "tailwind",
    "tailwindcss",
    "tw-in-js",
    "tailwind-in-js",
    "intellisense",
    "autocomplete"
  ],
  "type": "module",
  "// The 'module', 'unpkg' and 'types' fields are added by distilt": "",
  "main": "src/index.ts",
  "// Each entry is expanded into several bundles (types, esnext, module, script, node, and default)": "",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "// These are relative from within the dist/ folder": "",
  "sideEffects": false,
  "dependencies": {
    "@ctrl/tinycolor": "^3.4.1",
    "class-string-matcher": "0.1.0-alpha.1",
    "css-tree": "^2.2.1",
    "cssbeautify": "^0.3.1",
    "genex": "^1.1.0",
    "match-sorter": "^6.3.1",
    "moo": "^0.5.2",
    "quick-lru": "^6.1.1",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "@twind/preset-autoprefix": "^1.0.7",
    "@twind/preset-tailwind": "^1.1.4",
    "@types/css-tree": "^2.0.0",
    "@types/cssbeautify": "^0.3.2",
    "@types/showdown": "^2.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "@twind/core": "^1.1.3",
    "typescript": "^5.5.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "scripts": {
    "build": "distilt"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
